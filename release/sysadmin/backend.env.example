# Copy these values into the organisation's protected configuration store.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=mysql://event_app:CHANGE_ME@mysql.example.internal:3306/event_registration
DATABASE_CONNECT_TIMEOUT_MS=5000
MIGRATIONS_DIR=/opt/event-registration/database/migrations
CORS_ORIGINS=https://events.example.org,https://scanner.example.org
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
SESSION_TTL_SECONDS=28800
AUTH_LINK_SECRET=GENERATE_A_DIFFERENT_32_BYTE_SECRET
AUTH_LINK_BASE_URL=https://events.example.org/auth
INVITATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
QR_SIGNING_SECRET=GENERATE_A_THIRD_32_BYTE_SECRET
PUBLIC_WEB_BASE_URL=https://events.example.org
CONSENT_URL=https://events.example.org/privacy
CONSENT_VERSION=REPLACE_WITH_APPROVED_VERSION
EMAIL_MAX_ATTEMPTS=5
EMAIL_POLL_INTERVAL_MS=1000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Регистрация на мероприятие
SMTP_STARTTLS=true
