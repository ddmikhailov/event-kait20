generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum PersonType {
  KAIT_STUDENT
  KAIT_TEACHER
  EXTERNAL_STUDENT
  EXTERNAL_TEACHER

  @@map("person_type")
}

enum EventStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("event_status")
}

enum EventFormFieldType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  BOOLEAN

  @@map("event_form_field_type")
}

enum RegistrationSource {
  PUBLIC_FORM
  EXCEL_IMPORT
  ONSITE
  ADMIN_MANUAL

  @@map("registration_source")
}

enum RegistrationStatus {
  ACTIVE
  ANNULLED

  @@map("registration_status")
}

enum AttendanceMode {
  MANUAL_CONFIRM
  FAST_SCAN
  MANUAL_SEARCH
  ONSITE_REGISTRATION

  @@map("attendance_mode")
}

enum AttendanceSource {
  ONLINE
  OFFLINE_SYNC

  @@map("attendance_source")
}

enum StaffRole {
  SUPER_ADMIN
  SCANNER

  @@map("staff_role")
}

enum EventAccessRole {
  SCANNER
  EVENT_ADMIN

  @@map("event_access_role")
}

enum EmailDeliveryType {
  REGISTRATION_TICKET
  STAFF_INVITATION
  PASSWORD_RESET

  @@map("email_delivery_type")
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED

  @@map("email_delivery_status")
}

enum ImportJobStatus {
  PENDING
  PREVIEW_READY
  COMPLETED
  FAILED
  EXPIRED

  @@map("import_job_status")
}

model Person {
  id                  String     @id @default(uuid()) @db.Uuid
  lastName            String     @map("last_name") @db.VarChar(100)
  firstName           String     @map("first_name") @db.VarChar(100)
  middleName          String?    @map("middle_name") @db.VarChar(100)
  birthDate           DateTime?  @map("birth_date") @db.Date
  email               String?    @db.VarChar(320)
  emailNormalized     String?    @map("email_normalized") @db.VarChar(320)
  phone               String?    @db.VarChar(32)
  phoneNormalized     String?    @map("phone_normalized") @db.VarChar(32)
  personType          PersonType @map("person_type")
  organization        String?    @db.VarChar(255)
  studyGroup          String?    @map("study_group") @db.VarChar(100)
  dedupReviewRequired Boolean    @default(false) @map("dedup_review_required")
  mergedIntoId        String?    @map("merged_into_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  mergedInto    Person?        @relation("PersonMerges", fields: [mergedIntoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mergedPersons Person[]       @relation("PersonMerges")
  registrations Registration[]
  staffUsers    StaffUser[]

  @@index([emailNormalized], map: "persons_email_normalized_idx")
  @@index([phoneNormalized], map: "persons_phone_normalized_idx")
  @@index([birthDate], map: "persons_birth_date_idx")
  @@index([lastName, firstName, middleName], map: "persons_name_idx")
  @@map("persons")
}

model Event {
  id                   String      @id @default(uuid()) @db.Uuid
  title                String      @db.VarChar(255)
  slug                 String      @unique(map: "events_slug_key") @db.VarChar(255)
  description          String?     @db.Text
  coverObjectKey       String?     @map("cover_object_key") @db.VarChar(1024)
  startAt              DateTime    @map("start_at") @db.Timestamptz(3)
  endAt                DateTime    @map("end_at") @db.Timestamptz(3)
  timezone             String      @default("Europe/Moscow") @db.VarChar(64)
  location             String      @db.VarChar(500)
  registrationDeadline DateTime    @map("registration_deadline") @db.Timestamptz(3)
  capacity             Int
  status               EventStatus
  createdById          String      @map("created_by") @db.Uuid
  offlineDataVersion   BigInt      @default(1) @map("offline_data_version")
  archivedAt           DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy        StaffUser         @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  formFields       EventFormField[]
  registrations    Registration[]
  attendanceEvents AttendanceEvent[]
  eventAccess      EventAccess[]
  staffInvitations StaffInvitation[]
  emailDeliveries  EmailDelivery[]
  importJobs       ImportJob[]

  @@map("events")
}

model EventFormField {
  id        String             @id @default(uuid()) @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  type      EventFormFieldType
  label     String             @db.VarChar(255)
  required  Boolean            @default(false)
  sortOrder Int                @map("sort_order")
  options   Json?              @db.JsonB
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  event   Event                @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  answers RegistrationAnswer[]

  @@index([eventId], map: "event_form_fields_event_id_idx")
  @@map("event_form_fields")
}

model Registration {
  id                String             @id @default(uuid()) @db.Uuid
  publicId          String             @unique(map: "registrations_public_id_key") @map("public_id") @db.Uuid
  eventId           String             @map("event_id") @db.Uuid
  personId          String             @map("person_id") @db.Uuid
  source            RegistrationSource
  status            RegistrationStatus @default(ACTIVE)
  lastName          String             @map("last_name") @db.VarChar(100)
  firstName         String             @map("first_name") @db.VarChar(100)
  middleName        String?            @map("middle_name") @db.VarChar(100)
  birthDate         DateTime?          @map("birth_date") @db.Date
  email             String?            @db.VarChar(320)
  phone             String?            @db.VarChar(32)
  studyGroup        String?            @map("study_group") @db.VarChar(100)
  personType        PersonType         @map("person_type")
  organization      String?            @db.VarChar(255)
  consentAccepted   Boolean            @map("consent_accepted")
  consentVersion    String?            @map("consent_version") @db.VarChar(255)
  consentUrl        String?            @map("consent_url") @db.VarChar(2048)
  consentAcceptedAt DateTime?          @map("consent_accepted_at") @db.Timestamptz(3)
  registeredAt      DateTime           @map("registered_at") @db.Timestamptz(3)
  firstAttendedAt   DateTime?          @map("first_attended_at") @db.Timestamptz(3)
  annulledAt        DateTime?          @map("annulled_at") @db.Timestamptz(3)
  annulledById      String?            @map("annulled_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  event            Event                @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  person           Person               @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  annulledBy       StaffUser?           @relation("RegistrationAnnulledBy", fields: [annulledById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  answers          RegistrationAnswer[]
  attendanceEvents AttendanceEvent[]
  emailDeliveries  EmailDelivery[]

  @@index([eventId, status], map: "registrations_event_id_status_idx")
  @@index([eventId, lastName], map: "registrations_event_id_last_name_idx")
  @@index([eventId, phone], map: "registrations_event_id_phone_idx")
  @@index([eventId, email], map: "registrations_event_id_email_idx")
  @@index([eventId, studyGroup], map: "registrations_event_id_study_group_idx")
  @@index([personId], map: "registrations_person_id_idx")
  @@map("registrations")
}

model RegistrationAnswer {
  id                 String             @id @default(uuid()) @db.Uuid
  registrationId     String             @map("registration_id") @db.Uuid
  fieldId            String             @map("field_id") @db.Uuid
  fieldLabelSnapshot String             @map("field_label_snapshot") @db.VarChar(255)
  fieldTypeSnapshot  EventFormFieldType @map("field_type_snapshot")
  answer             Json               @db.JsonB
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  registration Registration   @relation(fields: [registrationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  field        EventFormField @relation(fields: [fieldId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([registrationId, fieldId], map: "registration_answers_registration_id_field_id_key")
  @@index([registrationId], map: "registration_answers_registration_id_idx")
  @@index([fieldId], map: "registration_answers_field_id_idx")
  @@map("registration_answers")
}

model AttendanceEvent {
  id                 String           @id @default(uuid()) @db.Uuid
  clientEventId      String           @unique(map: "attendance_events_client_event_id_key") @map("client_event_id") @db.Uuid
  eventId            String           @map("event_id") @db.Uuid
  registrationId     String           @map("registration_id") @db.Uuid
  scannerUserId      String?          @map("scanner_user_id") @db.Uuid
  deviceId           String?          @map("device_id") @db.Uuid
  mode               AttendanceMode
  source             AttendanceSource
  deviceScannedAt    DateTime         @map("device_scanned_at") @db.Timestamptz(3)
  estimatedScannedAt DateTime         @map("estimated_scanned_at") @db.Timestamptz(3)
  receivedAt         DateTime         @map("received_at") @db.Timestamptz(3)
  duplicate          Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scannerUser  StaffUser?   @relation("AttendanceScanner", fields: [scannerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([registrationId], map: "attendance_events_registration_id_idx")
  @@index([eventId, estimatedScannedAt], map: "attendance_events_event_id_estimated_scanned_at_idx")
  @@map("attendance_events")
}

model StaffUser {
  id                String    @id @default(uuid()) @db.Uuid
  personId          String?   @map("person_id") @db.Uuid
  email             String    @db.VarChar(320)
  emailNormalized   String    @unique(map: "staff_users_email_normalized_key") @map("email_normalized") @db.VarChar(320)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  systemRole        StaffRole @map("system_role")
  active            Boolean   @default(true)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  person                Person?              @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdEvents         Event[]              @relation("EventCreatedBy")
  annulledRegistrations Registration[]       @relation("RegistrationAnnulledBy")
  attendanceEvents      AttendanceEvent[]    @relation("AttendanceScanner")
  eventAccess           EventAccess[]        @relation("EventAccessUser")
  eventAccessGranted    EventAccess[]        @relation("EventAccessCreatedBy")
  invitationsCreated    StaffInvitation[]    @relation("InvitationInvitedBy")
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  emailDeliveries       EmailDelivery[]
  importJobs            ImportJob[]          @relation("ImportJobCreatedBy")
  auditEntries          AuditLog[]

  @@index([personId], map: "staff_users_person_id_idx")
  @@map("staff_users")
}

model EventAccess {
  id          String          @id @default(uuid()) @db.Uuid
  eventId     String          @map("event_id") @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  role        EventAccessRole
  createdById String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      StaffUser @relation("EventAccessUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy StaffUser @relation("EventAccessCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([eventId, userId], map: "event_access_event_id_user_id_key")
  @@index([userId], map: "event_access_user_id_idx")
  @@map("event_access")
}

model StaffInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  emailNormalized String    @map("email_normalized") @db.VarChar(320)
  tokenHash       String    @unique(map: "staff_invitations_token_hash_key") @map("token_hash") @db.VarChar(255)
  invitedById     String    @map("invited_by") @db.Uuid
  eventId         String?   @map("event_id") @db.Uuid
  role            StaffRole
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy StaffUser @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emailDeliveries EmailDelivery[]

  @@index([emailNormalized], map: "staff_invitations_email_normalized_idx")
  @@index([eventId], map: "staff_invitations_event_id_idx")
  @@map("staff_invitations")
}

model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  diagnosticMetadata Json?     @map("diagnostic_metadata") @db.JsonB

  user StaffUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user            StaffUser       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emailDeliveries EmailDelivery[]

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@map("password_reset_tokens")
}

model EmailDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  idempotencyKey    String              @unique(map: "email_deliveries_idempotency_key_key") @map("idempotency_key") @db.VarChar(255)
  type              EmailDeliveryType
  recipientEmail    String              @map("recipient_email") @db.VarChar(320)
  eventId           String?             @map("event_id") @db.Uuid
  registrationId    String?             @map("registration_id") @db.Uuid
  staffUserId       String?             @map("staff_user_id") @db.Uuid
  staffInvitationId String?             @map("staff_invitation_id") @db.Uuid
  passwordResetTokenId String?          @map("password_reset_token_id") @db.Uuid
  status            EmailDeliveryStatus
  attempts          Int                 @default(0)
  lastErrorCode     String?             @map("last_error_code") @db.VarChar(255)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  queuedAt          DateTime            @map("queued_at") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staffUser    StaffUser?    @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  staffInvitation StaffInvitation? @relation(fields: [staffInvitationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  passwordResetToken PasswordResetToken? @relation(fields: [passwordResetTokenId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status], map: "email_deliveries_status_idx")
  @@index([eventId], map: "email_deliveries_event_id_idx")
  @@index([registrationId], map: "email_deliveries_registration_id_idx")
  @@index([staffUserId], map: "email_deliveries_staff_user_id_idx")
  @@index([staffInvitationId], map: "email_deliveries_staff_invitation_id_idx")
  @@index([passwordResetTokenId], map: "email_deliveries_password_reset_token_id_idx")
  @@map("email_deliveries")
}

model ImportJob {
  id            String          @id @default(uuid()) @db.Uuid
  eventId       String          @map("event_id") @db.Uuid
  createdById   String          @map("created_by") @db.Uuid
  status        ImportJobStatus
  totalRows     Int             @default(0) @map("total_rows")
  validRows     Int             @default(0) @map("valid_rows")
  errorRows     Int             @default(0) @map("error_rows")
  duplicateRows Int             @default(0) @map("duplicate_rows")
  resultSummary Json?           @map("result_summary") @db.JsonB
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy StaffUser @relation("ImportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([eventId], map: "import_jobs_event_id_idx")
  @@index([createdById], map: "import_jobs_created_by_idx")
  @@map("import_jobs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(255)
  entityType  String   @map("entity_type") @db.VarChar(255)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser StaffUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorUserId], map: "audit_log_actor_user_id_idx")
  @@index([entityType, entityId], map: "audit_log_entity_type_entity_id_idx")
  @@index([createdAt], map: "audit_log_created_at_idx")
  @@map("audit_log")
}
