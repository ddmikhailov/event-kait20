{
  "name": "@event-registration/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "acceptance:db": "tsx scripts/start-acceptance-db.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint prisma.config.ts scripts src tests",
    "test": "pnpm run test:integration",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:schema": "prisma validate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "mysql2": "3.24.2"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "tsx": "4.23.12"
  }
}
