# Copy to deploy/production.env (ignored by Git) and replace every value.
PUBLIC_WEB_URL=https://events.example.org
PUBLIC_SCANNER_URL=https://scanner.example.org
PUBLIC_API_URL=https://api.events.example.org
CONSENT_URL=https://example.org/privacy
CONSENT_VERSION=2026-08-26
TRUSTED_PROXY_IPS=127.0.0.1

MYSQL_ROOT_PASSWORD=replace-with-random-32-byte-secret
MYSQL_APP_USER=event_app
MYSQL_APP_PASSWORD=replace-with-different-random-32-byte-secret
SESSION_SECRET=replace-with-random-base64-secret-1
AUTH_LINK_SECRET=replace-with-random-base64-secret-2
QR_SIGNING_SECRET=replace-with-random-base64-secret-3

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=event-mailer
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM_EMAIL=events@example.org
SMTP_FROM_NAME=Регистрация на мероприятие
SMTP_STARTTLS=true
