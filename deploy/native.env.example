# Install as /etc/event-registration/event-registration.env with mode 0640,
# owned by root:event-registration.
# Replace every example value. URL-encode reserved characters inside DATABASE_URL.
NODE_ENV=production
DATABASE_URL=mysql://event_app:replace-with-db-password@127.0.0.1:3306/event_registration
CORS_ORIGINS=https://events.example.org,https://scanner.example.org
SESSION_SECRET=replace-with-random-base64-secret-1
AUTH_LINK_SECRET=replace-with-random-base64-secret-2
AUTH_LINK_BASE_URL=https://events.example.org/auth
QR_SIGNING_SECRET=replace-with-random-base64-secret-3
PUBLIC_WEB_BASE_URL=https://events.example.org
CONSENT_URL=https://example.org/privacy
CONSENT_VERSION=2026-08-26

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=event-mailer
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM_EMAIL=events@example.org
SMTP_FROM_NAME=Регистрация на мероприятие
SMTP_STARTTLS=true
