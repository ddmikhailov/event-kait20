server {
  listen 80;
  listen [::]:80;
  server_name __WEB_DOMAIN__ __SCANNER_DOMAIN__ __API_DOMAIN__;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name __WEB_DOMAIN__;
  root /opt/event-registration/current/apps/web/dist;
  index index.html;
  server_tokens off;

  ssl_certificate __WEB_CERTIFICATE__;
  ssl_certificate_key __WEB_CERTIFICATE_KEY__;
  ssl_protocols TLSv1.2 TLSv1.3;

  include /etc/nginx/snippets/event-registration-web-security.conf;

  location = /index.html {
    include /etc/nginx/snippets/event-registration-web-security.conf;
    add_header Cache-Control "no-store" always;
  }
  location ~* \.(?:js|css|woff2|png|svg)$ { expires 1y; }
  location / { try_files $uri $uri/ /index.html; }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name __SCANNER_DOMAIN__;
  root /opt/event-registration/current/apps/scanner/dist;
  index index.html;
  server_tokens off;

  ssl_certificate __SCANNER_CERTIFICATE__;
  ssl_certificate_key __SCANNER_CERTIFICATE_KEY__;
  ssl_protocols TLSv1.2 TLSv1.3;

  include /etc/nginx/snippets/event-registration-scanner-security.conf;

  location = /index.html {
    include /etc/nginx/snippets/event-registration-scanner-security.conf;
    add_header Cache-Control "no-store" always;
  }
  location = /manifest.webmanifest {
    include /etc/nginx/snippets/event-registration-scanner-security.conf;
    default_type application/manifest+json;
    add_header Cache-Control "no-cache" always;
  }
  location = /sw.js {
    include /etc/nginx/snippets/event-registration-scanner-security.conf;
    add_header Cache-Control "no-cache" always;
  }
  location = /service-worker.js {
    include /etc/nginx/snippets/event-registration-scanner-security.conf;
    add_header Cache-Control "no-cache" always;
  }
  location ~* \.(?:js|css|woff2|png|svg)$ { expires 1y; }
  location / { try_files $uri $uri/ /index.html; }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name __API_DOMAIN__;
  server_tokens off;
  client_max_body_size 10m;

  ssl_certificate __API_CERTIFICATE__;
  ssl_certificate_key __API_CERTIFICATE_KEY__;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_hide_header Server;
  }
}
