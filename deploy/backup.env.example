# Install as /etc/event-registration/backup.env, owned by root:event-backup,
# mode 0640. The age recipient is public and is not an encryption private key.
MYSQL_BACKUP_DEFAULTS_FILE=/etc/event-registration/mysql-backup.cnf
AGE_RECIPIENT=replace-with-age-public-recipient
RETENTION_DAYS=30
BACKUP_DIRECTORY=/var/backups/event-registration
OPERATIONS_API_URL=https://api.example.org/health/ready
TLS_CERTIFICATE_FILE=/etc/letsencrypt/live/events.example.org/fullchain.pem
BACKUP_MAX_AGE_HOURS=30
DISK_MIN_FREE_PERCENT=15
EMAIL_QUEUE_MAX_AGE_SECONDS=900
# Optional existing organization HTTPS endpoint. The payload contains check names only.
OPERATIONS_ALERT_WEBHOOK_URL=
