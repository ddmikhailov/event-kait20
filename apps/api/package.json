{
  "name": "@event-registration/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src integration scripts",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "test:integration": "vitest run integration/backend-foundation.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@event-registration/config": "workspace:*",
    "@event-registration/contracts": "workspace:*",
    "@event-registration/utils": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "argon2": "0.45.1",
    "exceljs": "4.4.0",
    "multer": "2.2.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12"
  }
}
