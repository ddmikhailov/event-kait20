# Local development example only. Production uses release/sysadmin/backend.env.example
# copied to protected storage and selected by EVENT_REGISTRATION_ENV_FILE.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=mysql://event_app:CHANGE_ME@127.0.0.1:3306/event_registration
DATABASE_CONNECT_TIMEOUT_MS=5000
MIGRATIONS_DIR=backend/migrations
TEST_DATABASE_URL=
TEST_DATABASE_CONFIRM_RESET=
# TEST_DATABASE_URL only applies when you want the suite to reuse an
# already-running MySQL instead of managing its own disposable one. If set,
# the database name must contain "test" as its own word (e.g. ..._test), and
# TEST_DATABASE_CONFIRM_RESET must exactly repeat that database name to
# confirm you intend it to be reset — a name match alone is not enough. The
# suite also refuses to run if TEST_DATABASE_URL resolves to the same
# host/port/database as DATABASE_URL. Leave both empty (the default) to let
# the suite manage its own disposable MySQL instance instead — no
# confirmation is needed for that.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
SESSION_TTL_SECONDS=28800
AUTH_LINK_SECRET=GENERATE_A_DIFFERENT_32_BYTE_SECRET
AUTH_LINK_BASE_URL=http://localhost:5173/auth
INVITATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
QR_SIGNING_SECRET=GENERATE_A_THIRD_32_BYTE_SECRET
PUBLIC_WEB_BASE_URL=http://localhost:5173
CONSENT_URL=https://static.mskobr.ru/docs/soglasie_na_obrabotku_pnd.pdf
PRIVACY_POLICY_URL=https://st.educom.ru/eduoffices/gateways/get_file.php?id={C6751185-7D3C-F320-3D87-C704B3683104}&name=politika_v_otnoshenii_pd_rkait20.pdf
CONSENT_VERSION=local-demo
EMAIL_MAX_ATTEMPTS=5
EMAIL_POLL_INTERVAL_MS=1000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Регистрация на мероприятие
SMTP_STARTTLS=true
MEDIA_ROOT=.runtime/media
COVER_MAX_BYTES=5242880
VITE_API_BASE_URL=http://localhost:3000
