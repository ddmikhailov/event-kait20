+        list(executor.map(confirm, (first, second)))
+    with database.connect() as connection:
+        sequences = dict(
+            connection.execute(
+                text(
+                    "SELECT id,scoring_sequence FROM participations WHERE id IN (:first,:second)"
+                ),
+                {"first": first, "second": second},
+            ).all()
+        )
