+    with database.connect() as connection:
+        stable = dict(
+            connection.execute(
+                text(
+                    "SELECT id,scoring_sequence FROM participations WHERE id IN (:first,:second,:third)"
+                ),
+                {"first": first, "second": second, "third": third},
