{
  "name": "event-registration-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build && node scripts/python.mjs -m compileall -q backend/src",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && node scripts/python.mjs -m ruff check backend",
    "db:migrate:deploy": "node scripts/python.mjs -m event_api.migrate",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mvp": "node scripts/mvp-smoke.mjs",
    "test": "turbo run test && node scripts/python.mjs -m pytest backend/tests && node --test scripts/deploy-config.test.mjs scripts/mvp-smoke.test.mjs",
    "typecheck": "turbo run typecheck && node scripts/python.mjs -m mypy backend/src/event_api",
    "audit:dependencies": "pnpm audit --prod --audit-level high && node scripts/python.mjs -m pip_audit",
    "backend:install": "node scripts/python.mjs -m pip install -e backend[dev]",
    "backend:dev": "node scripts/python.mjs -m uvicorn event_api.main:app --reload --host 127.0.0.1 --port 3000",
    "backend:format": "node scripts/python.mjs -m ruff format backend",
    "deploy:check": "node scripts/deploy-config.mjs check",
    "deploy:render": "node scripts/deploy-config.mjs render",
    "demo:doctor": "node scripts/native-demo.mjs doctor",
    "demo:up": "node scripts/native-demo.mjs up",
    "demo:down": "node scripts/native-demo.mjs down",
    "demo:reset": "node scripts/native-demo.mjs reset"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
