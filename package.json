{
  "name": "event-registration-system",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "db:migrate:deploy": "pnpm --filter @event-registration/database exec prisma migrate deploy",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mvp": "node scripts/mvp-smoke.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
